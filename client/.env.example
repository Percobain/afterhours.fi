# WalletConnect Cloud project id. Leave empty to run with injected (browser-extension) wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# afterhours.fi server (see shared/INTERFACE.md). The app degrades gracefully when it is down.
# Pricing server. Leave unset on a static deploy (e.g. Vercel without a hosted server): the app uses backtest fallbacks.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Microsoft Clarity project id (defaults to the afterhours.fi project)
NEXT_PUBLIC_CLARITY_ID=ypde5xb455

# 11155111 = Ethereum Sepolia, 97 = BSC Testnet
NEXT_PUBLIC_DEFAULT_CHAIN_ID=97

# Alchemy key: wagmi transports use https://eth-sepolia.g.alchemy.com/v2/<key> and
# https://bnb-testnet.g.alchemy.com/v2/<key>. Falls back to the chains' public RPCs when empty.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional contract address overrides (normally read from src/deployments/<network>.json written by
# contracts/scripts/deploy.ts). Any that are set take precedence over the JSON file.
NEXT_PUBLIC_SEPOLIA_COVER_MARKET=
NEXT_PUBLIC_SEPOLIA_KEEPER_VAULT=
NEXT_PUBLIC_SEPOLIA_USDT=
NEXT_PUBLIC_SEPOLIA_ORACLE=
NEXT_PUBLIC_BSC_TESTNET_COVER_MARKET=
NEXT_PUBLIC_BSC_TESTNET_KEEPER_VAULT=
NEXT_PUBLIC_BSC_TESTNET_USDT=
NEXT_PUBLIC_BSC_TESTNET_ORACLE=
