# afterhours.fi server. Every value may be left empty: the server boots with defaults, runs an in-memory store when
# MongoDB is absent, returns unsigned quotes when the quoter key is absent, and disables admin routes when the secret is absent.

# --- core ---------------------------------------------------------------------------------------------------
PORT=4000
NODE_ENV=
LOG_LEVEL=
LOG_PRETTY=
MONGODB_URI=
# Database name (the URI usually has none; without this Mongo writes to "test")
MONGODB_DB=afterhours
# Used only if the OS resolver refuses the mongodb+srv SRV lookup
DNS_FALLBACK_SERVERS=8.8.8.8,1.1.1.1
QUOTER_PRIVATE_KEY=
ADMIN_SECRET=
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=

# --- RPC (Alchemy first) ------------------------------------------------------------------------------------
# Default RPC URLs are https://eth-sepolia.g.alchemy.com/v2/$ALCHEMY_API_KEY and https://bnb-testnet.g.alchemy.com/v2/$ALCHEMY_API_KEY.
# SEPOLIA_RPC_URL / BSC_TESTNET_RPC_URL are optional explicit overrides. Public RPCs are used only when both are empty (warned).
ALCHEMY_API_KEY=
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=

# --- Binance ------------------------------------------------------------------------------------------------
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
BINANCE_KLINES_ENABLED=
BINANCE_MAX_RPM=
BINANCE_SPOT_BASE=
BINANCE_WEB3_BASE=

# --- contract overrides (used when server/deployments/<network>.json is missing or to override it) ----------
CONTRACT_COVER_MARKET_11155111=
CONTRACT_KEEPER_VAULT_11155111=
CONTRACT_REFERENCE_ORACLE_11155111=
CONTRACT_USDT_11155111=
DEPLOY_BLOCK_11155111=
TOKENS_11155111=
CONTRACT_COVER_MARKET_97=
CONTRACT_KEEPER_VAULT_97=
CONTRACT_REFERENCE_ORACLE_97=
CONTRACT_USDT_97=
DEPLOY_BLOCK_97=
TOKENS_97=

# --- jobs ---------------------------------------------------------------------------------------------------
JOBS_ENABLED=
INDEXER_ENABLED=
INDEXER_INTERVAL_MS=
INDEXER_CHUNK_BLOCKS=
INDEXER_LOOKBACK_BLOCKS=
INDEXER_CONFIRMATIONS=
PRICE_REFRESH_CRON=
EPOCH_CLOSE_HOUR_UTC=
CLOSE_WINDOW_MINUTES=
OPEN_RETRY_MINUTES=
OPEN_RETRY_WINDOW_MINUTES=
OPEN_FALLBACK_AFTER_MINUTES=

# --- pricing ------------------------------------------------------------------------------------------------
QUOTE_TTL_SECONDS=
PRICING_LOAD=
PRICING_FLOOR_FRACTION=
PRICING_MAX_CHARGED_FRACTION=
DEFAULT_VOL=
