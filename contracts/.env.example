# Deployer / admin key (hex, with or without 0x). This address owns every contract: pause, params, rescue, force-settle.
DEPLOYER_PRIVATE_KEY=

# Off-chain pricing engine signer (the server's QUOTER_PRIVATE_KEY). Defaults to the deployer if empty.
QUOTER_ADDRESS=

# RPCs: with ALCHEMY_API_KEY set, Alchemy endpoints are used for both networks (eth-sepolia and bnb-testnet). Explicit URLs override.
ALCHEMY_API_KEY=
SEPOLIA_RPC_URL=
BSC_TESTNET_RPC_URL=

# Explorers (for `npx hardhat verify`)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
